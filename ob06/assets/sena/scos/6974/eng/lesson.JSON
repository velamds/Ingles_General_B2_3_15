 "type": "text"}], "correct": 0, "id": 0, "selected": 0}, {"_data": [{"content": "", "type": "text"}], "correct": 1, "id": 1, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "correct": 1, "id": 0, "selected": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn11le15ob06re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nFind a great website.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self-Assessment.\n", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "contents": [{}], "id": 0}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn11le15ob06re2aud01", "coverimg": "engenn11le15ob06re2img05.jpg", "images": [{"image": "engenn11le15ob06re2img05.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn11le15ob06re2img05.jpg", "text": "<span class=\"strong\">Adam</span>: \t\tKristi, maybe while we're waiting I could get you to look at this website I'm designing for the book.\n<br/> <span class=\"strong\">Kristi</span>: \t\tSure, I'd love to see it. I don't know how to make a website so I'm interested to see how you did it.\n<br/> <span class=\"strong\">Adam</span>:  \t\tSure, I'll go through the steps with you. The first thing is to choose the website building platform that you will use for your site.\n<br/> <span class=\"strong\">Kristi</span>:  \t\tIt sounds perplexing already.", "time": "100", "id": 1}, {"image": "engenn11le15ob06re2img06.jpg", "text": "<span class=\"strong\">Adam</span>: \t\tIt's not anymore. New content management systems like Word Press are very user-friendly. It's free to install and there's a community of users who have created templates and themes that anyone can use. People are adding resources all the time.\n<br/> <span class=\"strong\">Kristi</span>: \t\tIt sounds like there's lots of support.\n<br/> <span class=\"strong\">Adam</span>:  \t\tYes, there is. The next I thing I did was to choose a domain name and a host to represent the book and publisher. Hosting is a service that connects your website to the Internet. On Word Press those cost about $4 per month. You need to think up a brandable and catchy domain name.\n<br/> <span class=\"strong\">Kristi</span>:  \t\tThat would be the hard part for me.", "time": "18200", "id": 2}, {"image": "engenn11le15ob06re2img07.jpg", "text": "<span class=\"strong\">Adam</span>: \t\tYeah, and there are already 150 million domain names out there so you have to get creative. So, after you've installed your content management system you can choose a theme or a template and start adding your content, like images or text. You can customize the templates any way you want so that they reflect what you want to communicate to your viewers. You can add pages and link them to your navigation bar so you can group types of information. On this website I'm working on linking pages for the author bio and some social media safety information. I'll also add in some images from the book illustrations once I get those files. You should also edit your page titles and taglines so that people searching for your site can easily find it.\n<br/> <span class=\"strong\">Kristi</span>:  \t\tWow Adam! It really looks great. Thanks for showing me how you put it together.\n<br/> <span class=\"strong\">Adam</span>: \t\tMy pleasure. I'm still working on it. I think it will look great when it's all done.", "time": "56400", "id": 3}]}}], "id": 1}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "contents": [{"type": "img", "value": ""}], "id": 2}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "type": "sena"}